VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_ANON_KEY=<publishable key, sb_publishable_..., from Project Settings, API Keys>
# Public key for push notifications, from `node scripts/vapid.mjs`. Without it, Profile says notifications aren't set up.
VITE_VAPID_PUBLIC_KEY=
# Optional: Help & support contact rows (each hides when unset). Public, built into the bundle.
VITE_SUPPORT_EMAIL=
VITE_SUPPORT_PHONE=
