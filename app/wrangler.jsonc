{
  // Cloudflare Workers with static assets: serves app/dist from the edge.
  // Connected to GitHub through Workers Builds: main is production, every other
  // branch gets a preview URL and a comment on its pull request.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ontrack",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./dist",
    // Client-side routes and QR deep links (/e/<id>) resolve to index.html.
    "not_found_handling": "single-page-application",
    // Not auto-trailing-slash: that answers /index.html with a redirect to /. The
    // service worker falls back to fetching /index.html when its cached copy is
    // gone, and a browser refuses a redirect from a service worker on a page load,
    // so the reload fails with ERR_FAILED.
    "html_handling": "none",
  },
  "observability": { "enabled": true },
  // Each preview gets https://<branch>-ontrack.<subdomain>.workers.dev.
  "preview_urls": true,
  // Required by `wrangler preview`, the non-production branch deploy command.
  // Empty: previews inherit assets and compatibility settings from the top level.
  "previews": {},
}
